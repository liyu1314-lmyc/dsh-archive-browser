{
  "name": "dsh-archive-browser",
  "version": "0.2.1",
  "description": "Browse archived DSH sessions and re-invoke them: view the transcript, inspect what a session touched, restore to the sidebar, inject into the current conversation, or fork a new session.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "archive",
    "session",
    "restore",
    "impact",
    "cleanup"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/liyu1314-lmyc/dsh-archive-browser.git"
  },
  "bugs": {
    "url": "https://github.com/liyu1314-lmyc/dsh-archive-browser/issues"
  },
  "homepage": "https://github.com/liyu1314-lmyc/dsh-archive-browser#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
